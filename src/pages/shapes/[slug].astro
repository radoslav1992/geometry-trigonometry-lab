---
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import {faqs} from '../../lib/faqs.mjs';
import {lessons} from '../../lib/lessons.mjs';
import Layout from '../../layouts/Layout.astro';import ShapeCalculator from '../../components/ShapeCalculator.astro';import {SHAPES} from '../../lib/math.mjs';import {shapeFacts} from '../../lib/shape-facts.mjs';
export function getStaticPaths(){return Object.keys(shapeFacts).map(slug=>({params:{slug},props:{slug}}));}
const {slug}=Astro.props;const facts=shapeFacts[slug],shape=SHAPES[slug];const name=facts.heading.toLowerCase();const lesson=lessons.find(l=>l.slug===facts.lesson);
---
<Layout title={facts.seoTitle} headline={facts.heading} section="Shapes" description={facts.description}><div class="shape-page"><Breadcrumbs items={[['Shapes','/shapes/'],[facts.heading,`/shapes/${slug}/`]]}/><div class="intro"><div><div class="eyebrow">{facts.type}</div><h1>{facts.heading}: properties & formulas</h1><p>{facts.intro}</p><ul class="shape-quick" aria-label={`${facts.heading} at a glance`}>{facts.quick.map(([n,label])=><li><strong>{n}</strong> {label}</li>)}</ul></div></div>
<div class="shape-intro-grid shape-reference-grid"><section class="shape-fact-box"><h2>Properties of a {name}</h2><table class="fact-table"><tbody>{facts.properties.map(([key,val])=><tr><th scope="row">{key}</th><td>{val}</td></tr>)}</tbody></table></section><section class="shape-fact-box"><h2>{facts.heading} formulas</h2><table class="fact-table"><tbody>{facts.formulas.map(([key,val])=><tr><th scope="row">{key}</th><td class="rule-formula">{val}</td></tr>)}</tbody></table></section></div>
<h2>{shape.kind==='area'?`${facts.heading} area calculator`:`${facts.heading} volume & surface area calculator`}</h2><ShapeCalculator initial={slug} fixed/><AdSlot type="rectangle"/>
<div class="shape-intro-grid"><section class="shape-fact-box"><h2>A worked example</h2><p>{facts.example}</p></section><aside class="shape-fact-box"><h3>A common mistake</h3><p>{facts.pitfall}</p></aside></div><div class="related"><a href={`/learn/${facts.lesson}/`}>{lesson.heading||lesson.title} ↗</a>{facts.related.map(key=><a href={`/shapes/${key}/`}>Compare with a {shapeFacts[key].heading.toLowerCase()} ↗</a>)}{['cube','cuboid','pyramid'].includes(slug)&&<a href="/printable-nets/">Print a net to fold ↗</a>}<a href="/worksheets/">Create a practice sheet ↗</a></div><AdSlot type="native"/><Faq items={faqs[slug]} title={`${facts.heading}: common questions`}/></div></Layout>
