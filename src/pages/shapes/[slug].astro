---
import Faq from '../../components/Faq.astro';
import {faqs} from '../../lib/faqs.mjs';
import Layout from '../../layouts/Layout.astro';import ShapeCalculator from '../../components/ShapeCalculator.astro';import {SHAPES} from '../../lib/math.mjs';import {shapeFacts} from '../../lib/shape-facts.mjs';
export function getStaticPaths(){return Object.keys(shapeFacts).map(slug=>({params:{slug},props:{slug}}));}
const {slug}=Astro.props;const facts=shapeFacts[slug],shape=SHAPES[slug];
---
<Layout title={`${shape.title}: Properties, Formulas & Calculator`} section="Shapes" description={`Explore the ${shape.title.toLowerCase()}: ${facts.intro}`}><div class="breadcrumb"><a href="/shapes/">Shape atlas</a> / {shape.title}</div><div class="intro"><div><div class="eyebrow">{facts.type}</div><h1>{shape.title}</h1><p>{facts.intro}</p></div></div><ShapeCalculator initial={slug} fixed/><div class="shape-intro-grid"><section class="shape-fact-box"><h2>Know its properties</h2><table class="fact-table"><tbody>{facts.properties.map(([key,val])=><tr><td>{key}</td><td>{val}</td></tr>)}</tbody></table><h3>Useful formulas</h3>{facts.formulas.map(([key,val])=><p><strong>{key}:</strong> {val}</p>)}</section><aside class="shape-fact-box"><h3>A worked example</h3><p>{facts.example}</p><h3>A common mistake</h3><p>{facts.pitfall}</p></aside></div><div class="related"><a href={`/learn/${facts.lesson}/`}>Read the related lesson ↗</a>{facts.related.map(key=><a href={`/shapes/${key}/`}>Compare with a {SHAPES[key].title.toLowerCase()} ↗</a>)}<a href="/worksheets/">Create a practice sheet ↗</a></div><Faq items={faqs[slug]} title={`${shape.title}: common questions`}/></Layout>
