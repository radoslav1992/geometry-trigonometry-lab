---
import Layout from '../../layouts/Layout.astro';import {SHAPES} from '../../lib/math.mjs';import {shapeFacts} from '../../lib/shape-facts.mjs';
---
<Layout title="Interactive Shape Atlas — Properties, Formulas & Calculators" section="Shapes" description="Explore eight plane shapes and solids, compare their properties, and open a dedicated calculator with examples and common mistakes."><div class="intro"><div><div class="eyebrow">The shape atlas</div><h1>Get to know the shapes.</h1><p>Explore their properties, compare formulas, and try a calculation on every page.</p></div></div><div class="atlas-grid">{Object.entries(SHAPES).map(([slug,s])=><a class="atlas-card" href={`/shapes/${slug}/`}><span class="atlas-symbol" aria-hidden="true">{shapeFacts[slug].symbol}</span><span class="badge">{shapeFacts[slug].type}</span><h3>{s.title}</h3><p>{s.formula}</p><span class="text-link">Explore {s.title.toLowerCase()} ↗</span></a>)}</div><section class="explanation"><h2>Compare the formulas</h2><p>Use matching length units throughout. Area and surface area use squared units; volume uses cubed units.</p><div class="fact-table-wrap"><table class="fact-table"><thead><tr><th>Shape</th><th>Measurement</th><th>Formula</th></tr></thead><tbody>{Object.entries(shapeFacts).flatMap(([slug,f])=>f.formulas.slice(0,2).map(([label,formula])=><tr><td><a class="text-link" href={`/shapes/${slug}/`}>{SHAPES[slug].title}</a></td><td>{label}</td><td>{formula}</td></tr>))}</tbody></table></div></section></Layout>
