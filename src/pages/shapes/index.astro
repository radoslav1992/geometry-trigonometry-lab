---
import DiagramThumb from '../../components/DiagramThumb.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Layout from '../../layouts/Layout.astro';import {SHAPES} from '../../lib/math.mjs';import {shapeFacts} from '../../lib/shape-facts.mjs';
---
<Layout title="Shape Atlas: Properties & Formulas of 2D & 3D Shapes" headline="Shape atlas" schemaType="CollectionPage" section="Shapes" description="Properties and formulas of rectangles, circles, triangles, trapezoids, spheres, cylinders, cones, and rectangular prisms, each with its own calculator."><Breadcrumbs items={[['Shapes','/shapes/']]}/><div class="intro"><div><div class="eyebrow">The shape atlas · get to know the shapes</div><h1>2D &amp; 3D shapes: properties and formulas</h1><p>Explore their properties, compare formulas, and try a calculation on every page.</p></div></div><div class="atlas-grid">{Object.entries(SHAPES).map(([slug,s])=><a class="atlas-card" data-shape={slug} href={`/shapes/${slug}/`}><span class="atlas-symbol" aria-hidden="true"><DiagramThumb kind={slug}/></span><span class="badge">{shapeFacts[slug].type}</span><h3>{shapeFacts[slug].heading}</h3><p>{s.formula}</p><span class="text-link">Explore the {s.title.toLowerCase()} ↗</span></a>)}</div><section class="explanation"><h2>Compare the formulas</h2><p>Use matching length units throughout. Area and surface area use squared units; volume uses cubed units.</p><div class="fact-table-wrap"><table class="fact-table"><thead><tr><th>Shape</th><th>Measurement</th><th>Formula</th></tr></thead><tbody>{Object.entries(shapeFacts).flatMap(([slug,f])=>f.formulas.slice(0,2).map(([label,formula])=><tr><td><a class="text-link" href={`/shapes/${slug}/`}>{f.heading}</a></td><td>{label}</td><td>{formula}</td></tr>))}</tbody></table></div></section></Layout>
