---
import AdSlot from '../components/AdSlot.astro';
import LearningApps from '../components/LearningApps.astro';
import Faq from '../components/Faq.astro';
import {faqs} from '../lib/faqs.mjs';
import Layout from '../layouts/Layout.astro';
import UnitCircle from '../components/UnitCircle.astro';
import ToolCards from '../components/ToolCards.astro';
import {lessons} from '../lib/lessons.mjs';
import {shapeFacts} from '../lib/shape-facts.mjs';
const guides=['law-of-cosines','law-of-sines','herons-formula','arcs-and-sectors','transformations','area-and-perimeter','volume-and-surface-area'].map(slug=>lessons.find(l=>l.slug===slug));
---
<Layout title="Geometry Lab: Free Interactive Geometry & Trigonometry Tools" headline="Geometry Lab" description="Geometry Lab: free interactive geometry and trigonometry tools and calculators online. Solve triangles, explore the unit circle, and find area and volume.">
<section class="home-stage">
  <div class="home-intro"><div class="eyebrow">A playground for curious minds</div><h1>Free Interactive Geometry &amp; Trigonometry <em>Tools</em> and Calculators</h1><p><strong class="playful-lead">A little play. A big aha.</strong> Geometry Lab is a free online lab of interactive tools and calculators for students and teachers. Move a point, change an angle, and watch the math fall into place.</p><a class="primary-link" href="/tools/">Find your next experiment <span aria-hidden="true">↗</span></a><div class="home-note"><span class="note-mark" aria-hidden="true">↳</span><span>Start right here.<br/><strong>What happens at 90°?</strong></span></div><span class="free-note">Free to explore · No account needed</span></div>
  <div class="home-experiment"><UnitCircle compact/><a class="experiment-link" href="/unit-circle/">Open the full unit circle <span aria-hidden="true">↗</span></a></div>
</section>
<div class="stat-strip"><span><strong>15</strong>interactive explorers</span><span><strong>8</strong>shapes to discover</span><span><strong>16</strong>ideas explained</span><span><strong>100</strong>ways to practice</span></div>
<AdSlot type="rectangle"/>
<div class="section-heading"><div><div class="eyebrow">Follow your curiosity</div><h2>Interactive Geometry Calculators &amp; Explorers</h2><p>What will click today? Pick something interesting. See where it takes you.</p></div><a class="text-link" href="/tools/">All tools & collections ↗</a></div><ToolCards/>
<div class="section-heading"><div><div class="eyebrow">Formula guides</div><h2>Popular Geometry Formulas, Explained</h2><p>A direct answer, a calculator, and worked examples on every page.</p></div><a class="text-link" href="/learn/">All formula guides ↗</a></div>
<div class="guide-grid">{guides.map(l=><a class="guide-card" href={`/learn/${l.slug}/`}><span class="guide-formula">{l.formula}</span><strong>{l.heading||l.title}</strong><span>Formula · calculator · examples</span></a>)}<a class="guide-card" href="/unit-circle/"><span class="guide-formula">(cos θ, sin θ)</span><strong>Unit circle with tangent</strong><span>Interactive circle · exact-value chart</span></a></div>
<div class="related"><a href="/shapes/cuboid/">Rectangular prism ↗</a>{['cone','cylinder','sphere','trapezoid','rectangle'].map(slug=><a href={`/shapes/${slug}/`}>{shapeFacts[slug].heading} properties ↗</a>)}<a href="/printable-nets/">Printable nets ↗</a><a href="/printable-nets/cube/">Printable cube net ↗</a><a href="/triangle-solver/">Triangle solver ↗</a></div>
<div class="learning-strip"><div><span class="strip-label">SMALL STEPS. REAL UNDERSTANDING.</span><h2>You’ve got this. Try eight questions.</h2><p>No timer, no pressure. Just a little practice and a clearer picture.</p></div><a href="/practice/">Let’s give it a go ↗</a></div>
<AdSlot type="rectangle"/>
<LearningApps/><Faq items={faqs['home']} title="Geometry Lab: frequently asked questions"/></Layout>
