---
import ActivityTable from '../../../components/ActivityTable.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Layout from '../../../layouts/Layout.astro';import {activities,standards,tools} from '../../../lib/activities.mjs';
export function getStaticPaths(){return activities.map(act=>({params:{slug:act.lesson},props:{act}}));}
const {act}=Astro.props;const tool=tools[act.tool];
---
<Layout title={`Answer Key: ${act.title}`} headline={`Answer key: ${act.title}`} description={`Teacher answer key for the ${act.title}: the completed results table and worked answers, calculated with the same math as the tool.`} section="Teachers" schemaType="Article" noindex ads={false}><article class="worksheet answer-key"><Breadcrumbs items={[['Teachers','/teachers/'],['Answer key',`/teachers/answers/${act.lesson}/`]]}/>
<header class="worksheet-head"><div><div class="eyebrow">Teacher answer key · {act.grade} · about {act.minutes} minutes</div><h1>Answer key: {act.title}</h1></div></header>
<p class="key-note no-print">For teachers. This page is hidden from search engines and not linked from student pages, but it is not password-protected, so please don’t share the link with students. Student worksheet: <a href={`/learn/${act.lesson}/activity/`}>{act.title}</a>.</p>
<p class="worksheet-goal"><strong>Goal:</strong> {act.goal}</p>{act.standards.length>0&&<p class="worksheet-meta">Connects to Common Core {act.standards.map(code=>`${code} (${standards[code]})`).join('; ')}</p>}
<h2>Completed results table</h2><p class="worksheet-meta">Values are the readouts of the tool ({tool.name}) for each setting.</p><ActivityTable act={act} answers/>
<h2>Answers</h2><ol class="questions key-answers">{act.questions.map(q=><li><p class="key-question">{q.q}</p><p>{q.a}</p></li>)}</ol>
<div class="page-actions no-print"><button class="primary" type="button" data-print>Print answer key</button><a class="secondary" href="/teachers/">All activities</a></div></article></Layout>
<script>document.querySelector('[data-print]')?.addEventListener('click',()=>print());</script>
