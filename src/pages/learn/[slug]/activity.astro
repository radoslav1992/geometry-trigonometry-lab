---
import ActivityTable from '../../../components/ActivityTable.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ClassroomShare from '../../../components/ClassroomShare.astro';
import Layout from '../../../layouts/Layout.astro';import {lessons} from '../../../lib/lessons.mjs';import {activities,standards,tools} from '../../../lib/activities.mjs';
export function getStaticPaths(){return activities.map(act=>({params:{slug:act.lesson},props:{act}}));}
const {act}=Astro.props;const tool=tools[act.tool];const lesson=lessons.find(l=>l.slug===act.lesson);const heading=lesson.heading||lesson.title;
const url=new URL(`/learn/${act.lesson}/activity/`,Astro.site).href;
const description=`Free printable ${act.title.replace(/ Worksheet.*$/,'')} worksheet for ${act.grade.toLowerCase()}: about ${act.minutes} minutes with a free interactive tool. No sign-up; answer key for teachers.`;
const schema={'@context':'https://schema.org','@type':'LearningResource',name:act.title,description:act.goal,url,learningResourceType:'Worksheet',educationalLevel:act.grade,timeRequired:`PT${act.minutes}M`,isAccessibleForFree:true,inLanguage:'en',publisher:{'@type':'Organization',name:'Geometry Lab',url:new URL('/',Astro.site).href},...(act.standards.length?{educationalAlignment:act.standards.map(code=>({'@type':'AlignmentObject',alignmentType:'teaches',educationalFramework:'Common Core State Standards for Mathematics',targetName:code,targetDescription:standards[code]}))}:{})};
---
<Layout title={`${act.title}: Free Printable Activity`} headline={act.title} description={description} section="Learn" schema={schema}><article class="worksheet"><Breadcrumbs items={[['Learn','/learn/'],[heading,`/learn/${act.lesson}/`],['Classroom activity',`/learn/${act.lesson}/activity/`]]}/>
<header class="worksheet-head"><div><div class="eyebrow">Student activity · {act.grade} · about {act.minutes} minutes</div><h1>{act.title}</h1></div><div class="name-lines" aria-hidden="true"><span>Name</span><span>Class</span><span>Date</span></div></header>
<p class="worksheet-goal"><strong>Goal:</strong> {act.goal}</p><p class="worksheet-meta">Tool: {tool.name} at <strong>geometrylab.net{tool.href}</strong>{act.standards.length>0&&<span> · Connects to Common Core {act.standards.join(', ')}</span>}</p>
<div class="page-actions no-print"><button class="primary" type="button" data-print>Print worksheet</button><a class="secondary" href={tool.href}>Open {tool.name} <span aria-hidden="true">↗</span></a><ClassroomShare url={url}/></div>
<h2>What to do</h2><ol class="steps">{act.steps.map(step=><li>{step}</li>)}</ol>
<h2>Record your results</h2><ActivityTable act={act}/>
<h2>Questions</h2><ol class="questions">{act.questions.map(q=><li><p>{q.q}</p><div class="write-lines" aria-hidden="true">{Array.from({length:q.lines},()=><span/>)}</div></li>)}</ol>
<p class="worksheet-foot">Free from Geometry Lab · geometrylab.net{act.standards.length>0&&<span class="no-print"> · {act.standards.map(code=>`${code}: ${standards[code]}`).join(' ')}</span>}</p>
<p class="worksheet-teacher no-print">Teaching with this? Find the answer key and more activities on the <a href="/teachers/">Geometry Lab for teachers</a> page.</p></article></Layout>
<script>document.querySelector('[data-print]')?.addEventListener('click',()=>print());</script>
