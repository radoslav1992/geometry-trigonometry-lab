---
import Layout from '../../layouts/Layout.astro';import {lessons} from '../../lib/lessons.mjs';
export function getStaticPaths(){return lessons.map(lesson=>({params:{slug:lesson.slug},props:{lesson}}));}
const {lesson}=Astro.props;
---
<Layout title={`${lesson.title} — Formula & Worked Example`} section="Learn" description={lesson.subtitle+' '+lesson.body.slice(0,120)}><article class="article"><div class="breadcrumb"><a href="/learn/">Field notes</a> / {lesson.title}</div><div class="eyebrow">Geometry Lab reference</div><h1>{lesson.title}</h1><p>{lesson.subtitle}</p><div class="formula">{lesson.formula}</div><h2>The idea</h2><p>{lesson.body}</p><h2>Work through an example</h2><p>{lesson.example}</p><h2>What to watch for</h2><p>{lesson.pitfall}</p><div class="learning-strip"><div><h2>Make the formula move.</h2><p>Explore this idea with real inputs.</p></div><a href={lesson.href}>{lesson.cta} ↗</a></div><div class="related">{lessons.filter(l=>l.slug!==lesson.slug).slice(0,3).map(l=><a href={`/learn/${l.slug}/`}>{l.title} ↗</a>)}</div></article></Layout>
