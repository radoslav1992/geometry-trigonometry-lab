---
import DiagramThumb from '../../components/DiagramThumb.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Layout from '../../layouts/Layout.astro';import {lessons} from '../../lib/lessons.mjs';
---
<Layout title="Geometry & Trigonometry Formulas With Examples" headline="Geometry & trigonometry formula guides" schemaType="CollectionPage" section="Learn" description="Every geometry and trigonometry formula you need: Pythagoras, the laws of sines and cosines, Heron’s formula, sectors, transformations, area, and volume."><Breadcrumbs items={[['Learn','/learn/']]}/><div class="intro"><div><div class="eyebrow">Field notes · keep the useful ideas close</div><h1>Geometry &amp; trigonometry formulas</h1><p>Sixteen connected concepts, each with a direct answer, a calculator, worked examples, and guided paths through the tools.</p></div></div><div class="path-grid"><section class="path-card"><h3>Start with geometry</h3><p>Build from lengths to shapes.</p><ol><li><a href="/learn/pythagorean-theorem/">Right triangles</a></li><li><a href="/learn/area-and-perimeter/">Area and perimeter</a></li><li><a href="/tools/polygon-explorer/">Explore regular polygons</a></li><li><a href="/tools/triangle-playground/">Try a discovery challenge</a></li></ol></section><section class="path-card"><h3>Make sense of trigonometry</h3><p>Connect a turning point to a wave.</p><ol><li><a href="/learn/radians-and-degrees/">Angles and radians</a></li><li><a href="/unit-circle/">The unit circle</a></li><li><a href="/learn/trigonometric-ratios/">Sine, cosine, tangent</a></li><li><a href="/tools/trig-graphs/">Shape a trig graph</a></li></ol></section><section class="path-card"><h3>Explore the coordinate plane</h3><p>Describe position, distance, and movement.</p><ol><li><a href="/learn/distance-and-midpoint/">Distance and midpoint</a></li><li><a href="/learn/slope-and-lines/">Slope and lines</a></li><li><a href="/tools/transformations/">Transform a triangle</a></li><li><a href="/learn/similarity-and-scale/">Similarity and scale</a></li></ol></section></div><section class="explanation"><h2>Formula cheat sheet</h2><p>The key formula from every guide. Select a topic for variables, a calculator, and step-by-step examples.</p><div class="fact-table-wrap"><table class="fact-table"><thead><tr><th scope="col">Topic</th><th scope="col">Key formula</th></tr></thead><tbody>{lessons.map(l=><tr><td><a class="text-link" href={`/learn/${l.slug}/`}>{l.heading||l.title}</a></td><td class="rule-formula">{l.formula}</td></tr>)}</tbody></table></div></section><div class="section-heading"><h2>Every concept, in one place</h2></div><div class="tool-grid">{lessons.map(l=><a class="tool-card" href={`/learn/${l.slug}/`}><div class="card-top"><span class="badge">FIELD NOTE</span><span class="card-arrow">↗</span></div><div class="card-diagram"><DiagramThumb kind={l.slug}/></div><h3>{l.heading||l.title}</h3><p>{l.subtitle}</p><div class="card-meta">Formula · example · common mistake</div></a>)}</div></Layout>
