---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Printable 3D Shape Nets — Cube, Prism & Pyramid" section="Printables" description="Customize and download printable SVG nets for a cube, rectangular prism, or square pyramid. Includes fold lines, labels, and optional glue tabs."><div class="intro"><div><div class="eyebrow">A hands-on kind of geometry</div><h1>From a flat page to a solid idea.</h1><p>Choose a shape, set its size, then print, cut, and fold.</p></div></div><net-lab><div class="workbench"><div class="canvas-pane"><div class="canvas-top"><span class="canvas-title">Your printable net</span><span class="badge">A4 · PORTRAIT</span></div><div class="graph net-paper" data-preview></div><div class="graph-caption"><span>Solid lines: cut · dashed lines: fold</span><span>Dimensions in millimeters</span></div></div><div class="controls"><h3>Build something tangible.</h3><label class="field">Solid<select data-shape><option value="cube">Cube</option><option value="prism">Rectangular prism</option><option value="pyramid">Square pyramid</option></select></label><div data-fields></div><label class="check-row"><input data-tabs type="checkbox" checked/> Add glue tabs</label><label class="check-row"><input data-labels type="checkbox" checked/> Label the faces</label><p class="error" data-error role="alert"></p><button class="primary full-width" data-download>Download SVG</button><button class="secondary full-width" data-print style="margin-top:10px">Print / save as PDF</button><p class="small-note">Print on A4 at 100% scale. Turn off browser headers and footers. The 20 mm reference line lets you check the printed size.</p></div></div></net-lab><div class="explanation"><h2>Cut, fold, connect.</h2><ol><li>Cut along the solid outline, including any glue tabs.</li><li>Fold inward along each dashed line.</li><li>Apply glue to the tabs and bring neighboring faces together.</li></ol><p>For the pyramid, “slant height” is the altitude of a triangular face. It must be greater than half the base width to create a non-flat pyramid.</p></div><noscript>Enable JavaScript to generate, download, or print a net.</noscript></Layout>
<script>
import {fmt} from '../lib/math.mjs';
class NetLab extends HTMLElement {
 connectedCallback(){let shape='cube',svgText='';const defs:Record<string,any>={cube:{labels:['Edge length (mm)'],values:[30]},prism:{labels:['Width (mm)','Height (mm)','Depth (mm)'],values:[35,40,25]},pyramid:{labels:['Base width (mm)','Slant height (mm)'],values:[40,45]}};
 const render=()=>{const vals=Array.from(this.querySelectorAll<HTMLInputElement>('[data-dimension]')).map(i=>i.value===''?NaN:Number(i.value));const tabs=(this.querySelector('[data-tabs]') as HTMLInputElement).checked;const labels=(this.querySelector('[data-labels]') as HTMLInputElement).checked;const buttons=this.querySelectorAll<HTMLButtonElement>('[data-download],[data-print]');try{if(vals.some(v=>!Number.isFinite(v)||v<5||v>100))throw Error('Use dimensions between 5 and 100 mm.');let faces:{name:string,pts:number[][]}[]=[];const [a,b=a,c=a]=vals;
 if(shape==='pyramid'){if(b<=a/2)throw Error('Slant height must be greater than half the base width.');faces=[{name:'Base',pts:[[0,0],[a,0],[a,a],[0,a]]},{name:'Face',pts:[[0,0],[a/2,-b],[a,0]]},{name:'Face',pts:[[a,0],[a+b,a/2],[a,a]]},{name:'Face',pts:[[a,a],[a/2,a+b],[0,a]]},{name:'Face',pts:[[0,a],[-b,a/2],[0,0]]}];}
 else {const w=a,h=shape==='cube'?a:b,d=shape==='cube'?a:c;const rect=(x:number,y:number,ww:number,hh:number,name:string)=>({name,pts:[[x,y],[x+ww,y],[x+ww,y+hh],[x,y+hh]]});faces=[rect(0,d,w,h,'Front'),rect(w,d,d,h,'Right'),rect(w+d,d,w,h,'Back'),rect(2*w+d,d,d,h,'Left'),rect(0,0,w,d,'Top'),rect(0,d+h,w,d,'Bottom')];}
 const all=faces.flatMap(f=>f.pts);const minX=Math.min(...all.map(p=>p[0])),maxX=Math.max(...all.map(p=>p[0])),minY=Math.min(...all.map(p=>p[1])),maxY=Math.max(...all.map(p=>p[1]));if(maxX-minX+(tabs?12:0)>180||maxY-minY+(tabs?12:0)>210)throw Error('This net is too large for one A4 page. Reduce the dimensions.');
 const tx=95-(maxX+minX)/2,ty=125-(maxY+minY)/2;const edgeKey=(p:number[],q:number[])=>[p.join(','),q.join(',')].sort().join('|');const edges=new Map<string,{p:number[],q:number[],count:number}>();for(const f of faces)for(let i=0;i<f.pts.length;i++){const p=f.pts[i],q=f.pts[(i+1)%f.pts.length],key=edgeKey(p,q);const existing=edges.get(key);if(existing)existing.count++;else edges.set(key,{p,q,count:1});}
 let content=faces.map(f=>`<polygon points="${f.pts.map(p=>p.join(',')).join(' ')}" fill="#f8fbf9"/>${labels?`<text x="${f.pts.reduce((s,p)=>s+p[0],0)/f.pts.length}" y="${f.pts.reduce((s,p)=>s+p[1],0)/f.pts.length}" text-anchor="middle" dominant-baseline="middle" font-size="3.4" fill="#66796f">${f.name}</text>`:''}`).join('');
 // Seven external glue seams close a box. Four side seams close a pyramid.
 const boxTabEdges=shape==='pyramid'?new Set<string>([edgeKey(faces[1].pts[0],faces[1].pts[1]),edgeKey(faces[1].pts[1],faces[1].pts[2]),edgeKey(faces[3].pts[0],faces[3].pts[1]),edgeKey(faces[3].pts[1],faces[3].pts[2])]):new Set<string>([edgeKey(faces[3].pts[1],faces[3].pts[2]),...([4,5].flatMap(i=>{const f=faces[i];return f.pts.map((p,j)=>edgeKey(p,f.pts[(j+1)%4])).filter(key=>edges.get(key)!.count===1)}))]);
 for(const [key,{p,q,count}]of edges){const addTab=tabs&&count===1&&boxTabEdges.has(key);content+=`<line x1="${p[0]}" y1="${p[1]}" x2="${q[0]}" y2="${q[1]}" stroke="#263e34" stroke-width="0.3" ${count>1||addTab?'stroke-dasharray="2 1.5"':''}/>`;if(addTab){const dx=q[0]-p[0],dy=q[1]-p[1],len=Math.hypot(dx,dy),depth=Math.min(5,len/5),inset=Math.min(3,len/6);const ux=dx/len,uy=dy/len,nx=uy,ny=-ux;const pp=[p[0]+ux*inset+nx*depth,p[1]+uy*inset+ny*depth],qq=[q[0]-ux*inset+nx*depth,q[1]-uy*inset+ny*depth];content+=`<path d="M ${p.join(' ')} L ${pp.join(' ')} L ${qq.join(' ')} L ${q.join(' ')}" fill="#edf3ef" stroke="#263e34" stroke-width="0.3"/>`;}}
 svgText=`<svg xmlns="http://www.w3.org/2000/svg" width="190mm" height="250mm" viewBox="0 0 190 250" role="img" aria-label="Printable ${shape} net"><rect width="190" height="250" fill="white"/><text x="10" y="12" font-family="sans-serif" font-size="5" fill="#173c3a">Geometry Lab · ${shape==='prism'?'Rectangular prism':shape==='pyramid'?'Square pyramid':'Cube'}</text><text x="10" y="20" font-family="sans-serif" font-size="3" fill="#617674">${vals.map(v=>fmt(v)).join(' × ')} mm · solid: cut · dashed: fold</text><g transform="translate(${tx} ${ty})" font-family="sans-serif">${content}</g><path d="M 10 236 v 4 M 10 238 h 20 M 30 236 v 4" stroke="#263e34" stroke-width="0.4"/><text x="36" y="239" font-family="sans-serif" font-size="3">20 mm scale check · print at 100%</text></svg>`;
 this.querySelector('[data-preview]')!.innerHTML=svgText;this.querySelector('[data-error]')!.textContent='';buttons.forEach(b=>b.disabled=false);
 }catch(e){this.querySelector('[data-error]')!.textContent=(e as Error).message;this.querySelector('[data-preview]')!.innerHTML='<p style="padding:40px">Adjust the dimensions to generate a printable net.</p>';svgText='';buttons.forEach(b=>b.disabled=true)}};
 const setup=()=>{this.querySelector('[data-fields]')!.innerHTML=defs[shape].labels.map((s:string,i:number)=>`<label class="field">${s}<input data-dimension type="number" min="5" max="100" step="1" value="${defs[shape].values[i]}"/></label>`).join('');this.querySelectorAll<HTMLInputElement>('[data-dimension]').forEach(i=>i.oninput=render);render()};(this.querySelector('[data-shape]') as HTMLSelectElement).onchange=e=>{shape=(e.target as HTMLSelectElement).value;setup()};this.querySelectorAll<HTMLInputElement>('[data-tabs],[data-labels]').forEach(i=>i.onchange=render);(this.querySelector('[data-download]') as HTMLButtonElement).onclick=()=>{if(!svgText)return;const u=URL.createObjectURL(new Blob([svgText],{type:'image/svg+xml'}));const a=document.createElement('a');a.href=u;a.download=`geometry-lab-${shape}-net.svg`;a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)};(this.querySelector('[data-print]') as HTMLButtonElement).onclick=()=>{if(svgText)window.print()};setup();
 }
}
customElements.define('net-lab',NetLab);
</script>
