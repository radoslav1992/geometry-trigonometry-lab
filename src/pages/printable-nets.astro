---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import {faqs} from '../lib/faqs.mjs';
import {NETS,netSvg} from '../lib/nets.mjs';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Printable Nets: Cube, Prism & Square Pyramid (Free)" headline="Printable 3D shape nets" section="Printables" description="Free printable 3D shape nets for a cube, rectangular prism, and square pyramid. Set the size, add glue tabs and labels, then print at 100% or download an SVG."><Breadcrumbs items={[['Printables','/printable-nets/']]}/><div class="intro"><div><div class="eyebrow">A hands-on kind of geometry · from a flat page to a solid idea</div><h1>Printable nets for 3D shapes</h1><p>Choose a cube, rectangular prism, or square pyramid net, set its size in millimeters, then print, cut, and fold. Every net has dashed fold lines, labeled faces, and optional glue tabs.</p></div></div><section class="no-print" aria-labelledby="net-gallery-heading"><h2 id="net-gallery-heading">Choose a net to print</h2><div class="net-gallery">{Object.entries(NETS).map(([shape,net])=><article class="net-card"><img src={`/nets/${net.file}.svg`} width="190" height="250" loading="lazy" alt={`Printable ${net.title.toLowerCase()} net with labeled faces, dashed fold lines, and glue tabs`}/><h3>{net.title} net</h3><p><strong>{net.faces} faces · {net.edges} edges · {net.vertices} vertices.</strong> {net.text}</p><div class="net-actions"><a href="#net-lab" data-pick={shape}>Customize the size</a><a href={`/nets/${net.file}.svg`} download={`geometry-lab-${net.file}.svg`}>Download SVG</a></div></article>)}</div></section><net-lab id="net-lab"><div class="workbench"><div class="canvas-pane"><div class="canvas-top"><span class="canvas-title">Your printable net</span><span class="badge">A4 · PORTRAIT</span></div><div class="graph net-paper" data-preview set:html={netSvg('cube',NETS.cube.values)}></div><div class="graph-caption"><span>Solid lines: cut · dashed lines: fold</span><span>Dimensions in millimeters</span></div></div><div class="controls"><h3>Build something tangible.</h3><label class="field">Solid<select data-shape>{Object.entries(NETS).map(([shape,net])=><option value={shape}>{net.title}</option>)}</select></label><div data-fields></div><label class="check-row"><input data-tabs type="checkbox" checked/> Add glue tabs</label><label class="check-row"><input data-labels type="checkbox" checked/> Label the faces</label><p class="error" data-error role="alert"></p><button class="primary full-width" data-download>Download SVG</button><button class="secondary full-width" data-print style="margin-top:10px">Print / save as PDF</button><p class="small-note">Print on A4 at 100% scale. Turn off browser headers and footers. The 20 mm reference line lets you check the printed size.</p></div></div></net-lab><div class="explanation"><h2>Cut, fold, connect.</h2><ol><li>Cut along the solid outline, including any glue tabs.</li><li>Fold inward along each dashed line.</li><li>Apply glue to the tabs and bring neighboring faces together.</li></ol><p>For the pyramid, “slant height” is the altitude of a triangular face. It must be greater than half the base width to create a non-flat pyramid.</p></div><noscript>Enable JavaScript to change the size or tabs. The cube net above prints at 30 mm, and each net in the gallery can be downloaded as an SVG.</noscript><div class="no-print"><div class="related"><a href="/shapes/cuboid/">Rectangular prism formulas ↗</a><a href="/learn/volume-and-surface-area/">Volume & surface area ↗</a><a href="/volume-calculator/">Volume calculator ↗</a></div><Faq items={faqs['printable-nets']} title="Printable nets: common questions"/></div></Layout>
<script>
import {NETS,netSvg} from '../lib/nets.mjs';
class NetLab extends HTMLElement {
 connectedCallback(){let shape='cube',svgText='';
 const render=()=>{const vals=Array.from(this.querySelectorAll<HTMLInputElement>('[data-dimension]')).map(i=>i.value===''?NaN:Number(i.value));const tabs=(this.querySelector('[data-tabs]') as HTMLInputElement).checked;const labels=(this.querySelector('[data-labels]') as HTMLInputElement).checked;const buttons=this.querySelectorAll<HTMLButtonElement>('[data-download],[data-print]');try{svgText=netSvg(shape,vals,{tabs,labels});
 this.querySelector('[data-preview]')!.innerHTML=svgText;this.querySelector('[data-error]')!.textContent='';buttons.forEach(b=>b.disabled=false);
 }catch(e){this.querySelector('[data-error]')!.textContent=(e as Error).message;this.querySelector('[data-preview]')!.innerHTML='<p style="padding:40px">Adjust the dimensions to generate a printable net.</p>';svgText='';buttons.forEach(b=>b.disabled=true)}};
 const select=this.querySelector('[data-shape]') as HTMLSelectElement;
 const setup=()=>{this.querySelector('[data-fields]')!.innerHTML=NETS[shape].labels.map((s:string,i:number)=>`<label class="field">${s}<input data-dimension type="number" min="5" max="100" step="1" value="${NETS[shape].values[i]}"/></label>`).join('');this.querySelectorAll<HTMLInputElement>('[data-dimension]').forEach(i=>i.oninput=render);render()};select.onchange=()=>{shape=select.value;setup()};this.querySelectorAll<HTMLInputElement>('[data-tabs],[data-labels]').forEach(i=>i.onchange=render);(this.querySelector('[data-download]') as HTMLButtonElement).onclick=()=>{if(!svgText)return;const u=URL.createObjectURL(new Blob([svgText],{type:'image/svg+xml'}));const a=document.createElement('a');a.href=u;a.download=`geometry-lab-${NETS[shape].file}.svg`;a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)};(this.querySelector('[data-print]') as HTMLButtonElement).onclick=()=>{if(svgText)window.print()};
 document.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach(a=>a.addEventListener('click',()=>{shape=a.dataset.pick!;select.value=shape;setup()}));setup();
 }
}
customElements.define('net-lab',NetLab);
</script>
