---
import AdSlot from '../components/AdSlot.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ClassroomBar from '../components/ClassroomBar.astro';
import Faq from '../components/Faq.astro';
import {faqs} from '../lib/faqs.mjs';
import {activitiesForTool} from '../lib/activities.mjs';
import {lessons} from '../lib/lessons.mjs';
import Layout from '../layouts/Layout.astro';import ShapeCalculator from '../components/ShapeCalculator.astro';
const chart=lessons.find(l=>l.slug==='volume-and-surface-area').table;
---
<Layout title="Volume & Surface Area Calculator for 3D Shapes" headline="Volume & surface area calculator" section="Area & volume" description="Calculate volume and total surface area for spheres, cylinders, cones, and rectangular prisms with visual diagrams, worked substitutions, and a formula chart."><Breadcrumbs items={[['Tools','/tools/'],['Volume calculator','/volume-calculator/']]}/><div class="intro"><div><div class="eyebrow">Think in three dimensions · make room for another dimension</div><h1>Volume &amp; surface area calculator</h1><p>Pick a sphere, cylinder, cone, or rectangular prism. Explore the space inside a solid and the surface that wraps around it.</p></div></div><ClassroomBar activities={activitiesForTool('volume-calculator')}/><ShapeCalculator initial="cylinder"/><AdSlot type="rectangle"/>
<section class="explanation"><h2>{chart.title}</h2><p>Volume is in cubic units and surface area is in square units. 1 cm³ holds 1 mL, so 1,000 cm³ = 1 liter.</p><div class="fact-table-wrap"><table class="fact-table"><thead><tr>{chart.head.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{chart.rows.map(row=><tr>{row.map(cell=><td>{cell}</td>)}</tr>)}</tbody></table></div></section>
<div class="related"><a href="/printable-nets/">Build a solid from a printable net ↗</a><a href="/learn/volume-and-surface-area/">Volume & surface area formulas with examples ↗</a><a href="/shapes/cuboid/">Rectangular prism ↗</a><a href="/shapes/cone/">Cone ↗</a></div><AdSlot type="native"/><Faq items={faqs['volume-calculator']} title="Volume and surface area questions"/></Layout>
