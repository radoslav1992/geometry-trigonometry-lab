---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Geometry & Trigonometry Practice — Free Quiz with Explanations" section="Practice" description="Practice angles, area, volume, the unit circle, and trigonometric ratios. Eight-question rounds with immediate explanations and local best scores."><div class="intro"><div><div class="eyebrow">A little practice goes a long way</div><h1>Turn “I think” into “I know.”</h1><p>Eight questions. No timer. A useful explanation after every answer.</p></div></div><practice-lab><div class="tabs" aria-label="Practice topic"><button class="tab active" data-topic="mixed" aria-pressed="true">A bit of everything</button><button class="tab" data-topic="geometry" aria-pressed="false">Geometry</button><button class="tab" data-topic="trigonometry" aria-pressed="false">Trigonometry</button></div><div class="question-card"><div class="question-top"><span data-count></span><span data-score></span></div><div class="progress" role="progressbar" aria-label="Questions answered" aria-valuemin="0" aria-valuemax="8" aria-valuenow="0"><div data-progress style="width:0"></div></div><div data-body></div><div class="feedback" data-feedback aria-live="polite"></div><button class="primary" data-next hidden>Next question →</button><p class="small-note" data-best></p></div></practice-lab><noscript>Enable JavaScript to answer practice questions. The formula reference is available without JavaScript.</noscript><div class="related"><a href="/learn/">Need a refresher? Browse the field notes ↗</a><a href="/unit-circle/">Explore the unit circle ↗</a></div></Layout>
<script>
import {makeRound} from '../lib/practice.mjs';
class PracticeLab extends HTMLElement {
 connectedCallback(){let topic='mixed',round=makeRound(topic),index=0,score=0,answered=false;const next=this.querySelector('[data-next]') as HTMLButtonElement;const body=this.querySelector('[data-body]')!;const feedback=this.querySelector('[data-feedback]')!;
 const best=()=>{try{const saved=localStorage.getItem('geometry-lab-best-'+topic);this.querySelector('[data-best]')!.textContent=saved?`Best on this device: ${saved}/8. Scores stay in this browser.`:'Your best score is saved only in this browser.';}catch{this.querySelector('[data-best]')!.textContent='Scores are available for this session. Browser storage is unavailable.'}};
 const updateProgress=()=>{const count=index+(answered?1:0);(this.querySelector('[data-progress]') as HTMLElement).style.width=`${count/8*100}%`;this.querySelector('[role=progressbar]')!.setAttribute('aria-valuenow',String(count));this.querySelector('[data-score]')!.textContent=`${score} correct`};
 const show=()=>{answered=false;next.hidden=true;feedback.textContent='';this.querySelector('[data-count]')!.textContent=`Question ${index+1} of 8`;const q=round[index];body.innerHTML=`<span class="badge">${q.topic.toUpperCase()}</span><h2 class="question" tabindex="-1">${q.q}</h2><div class="answer-options">${q.choices.map((c:any,i:number)=>`<button data-answer="${i}">${c.text}</button>`).join('')}</div>`;body.querySelectorAll<HTMLButtonElement>('[data-answer]').forEach(b=>b.onclick=()=>{if(answered)return;answered=true;const n=Number(b.dataset.answer);if(q.choices[n].correct)score++;body.querySelectorAll<HTMLButtonElement>('[data-answer]').forEach((button,i)=>{button.disabled=true;if(q.choices[i].correct)button.classList.add('correct');else if(i===n)button.classList.add('incorrect')});feedback.textContent=(q.choices[n].correct?'That’s right. ':'Not quite. ')+q.why;next.hidden=false;next.textContent=index===7?'See your result →':'Next question →';updateProgress()});updateProgress();best()};
 next.onclick=()=>{if(index===7){try{const key='geometry-lab-best-'+topic;const old=Number(localStorage.getItem(key)||0);localStorage.setItem(key,String(Math.max(old,score)))}catch{}this.querySelector('[data-count]')!.textContent='Round complete';body.innerHTML=`<span class="badge">PRACTICE COMPLETE</span><h2 class="question" tabindex="-1">${score} out of 8. ${score===8?'Beautifully done.':score>=5?'You’re making connections.':'Every answer is a place to start.'}</h2><p>Try another round, or revisit a tool to explore the ideas in motion.</p><button class="primary" data-again>Start another round</button>`;feedback.textContent='';next.hidden=true;best();(body.querySelector('[data-again]') as HTMLButtonElement).onclick=reset;(body.querySelector('.question') as HTMLElement).focus();}else{index++;show();(body.querySelector('.question') as HTMLElement).focus()}};
 const reset=()=>{round=makeRound(topic);index=0;score=0;show()};this.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach(b=>b.onclick=()=>{topic=b.dataset.topic!;this.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach(x=>{x.classList.toggle('active',x===b);x.setAttribute('aria-pressed',String(x===b))});reset()});show();
 }
}
customElements.define('practice-lab',PracticeLab);
</script>
