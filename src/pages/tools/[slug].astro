---
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ClassroomBar from '../../components/ClassroomBar.astro';
import Faq from '../../components/Faq.astro';
import TransformationRules from '../../components/TransformationRules.astro';
import {faqs} from '../../lib/faqs.mjs';
import {activitiesForTool} from '../../lib/activities.mjs';
import {lessons} from '../../lib/lessons.mjs';
import Layout from '../../layouts/Layout.astro';import Exploration from '../../components/Exploration.astro';import {explorations,toolSeo} from '../../lib/explorations.mjs';
export function getStaticPaths(){return explorations.map(tool=>({params:{slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props;const seo=toolSeo[tool.slug];const lesson=lessons.find(l=>l.slug===tool.lesson);
// Every tool page links to the other tools, so none depends on the catalog alone for discovery.
const moreTools=[...explorations.filter(t=>t.slug!==tool.slug).map(t=>[t.title,`/tools/${t.slug}/`]),['Interactive unit circle','/unit-circle/'],['Triangle solver','/triangle-solver/']];
---
<Layout title={seo.title} headline={tool.title} description={seo.description} section="Tools"><Breadcrumbs items={[['Tools','/tools/'],[tool.title,`/tools/${tool.slug}/`]]}/><div class="intro"><div><div class="eyebrow">{tool.category} · interactive lab</div><h1>{seo.h1||tool.title}</h1><p>{seo.intro||tool.description}</p></div></div><ClassroomBar activities={activitiesForTool(tool.slug)}/><Exploration tool={tool}/><AdSlot type="rectangle"/>{tool.slug==='transformations'&&<TransformationRules lessonLink/>}<div class="related"><a href={`/learn/${tool.lesson}/`}>{lesson.heading||lesson.title}: formulas & worked examples ↗</a><a href="/practice/">Practice this topic ↗</a><a href="/worksheets/">Create a worksheet ↗</a></div><h2 class="related-heading">More interactive geometry tools</h2><div class="related">{moreTools.map(([label,href])=><a href={href}>{label} ↗</a>)}<a href="/tools/">All tools ↗</a></div><Faq items={faqs[tool.slug]} title={`${tool.title}: common questions`}/></Layout>
