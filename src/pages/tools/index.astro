---
import DiagramThumb from '../../components/DiagramThumb.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Layout from '../../layouts/Layout.astro';import {catalog} from '../../lib/catalog.mjs';
---
<Layout title="Free Geometry Calculators & Trigonometry Tools" headline="Geometry & trigonometry tools" schemaType="CollectionPage" section="Tools" description="Free visual geometry calculators: triangle solver, unit circle, area and volume, sectors, transformations, polygons, graphs, quizzes, and printable worksheets."><Breadcrumbs items={[['Tools','/tools/']]}/><div class="intro"><div><div class="eyebrow">The complete toolkit · find your next connection</div><h1>Geometry calculators &amp; tools</h1><p>From a missing angle to a moving wave: choose a tool and start exploring.</p></div></div><tool-catalog><div class="catalog-controls"><input type="search" aria-label="Search tools" placeholder="Search triangles, slope, sine, worksheets…" data-search/><div class="pills" aria-label="Tool category">{['All','Geometry','Trigonometry','Coordinates','Solids','Practice','Reference'].map((c,i)=><button class:list={['pill',{selected:i===0}]} aria-pressed={i===0} data-category={c}>{c}</button>)}</div></div><p class="catalog-count" data-count aria-live="polite">{catalog.length} tools and collections</p><div class="tool-grid">{catalog.map(t=><a class="tool-card" data-category={t.category} href={t.href} data-tool data-topic={t.category} data-text={`${t.title} ${t.description} ${t.category}`.toLowerCase()}><div class="card-top"><span class="card-kicker">EXPLORE & UNDERSTAND</span><span class="badge">{t.category}</span></div><div class="card-diagram"><DiagramThumb kind={t.href}/></div><h3>{t.title}</h3><p>{t.description}</p><div class="card-meta">{t.meta}</div></a>)}</div><p class="catalog-empty" data-empty hidden>No matching tools. Try a broader word or choose “All”.</p></tool-catalog></Layout>
<script>
class ToolCatalog extends HTMLElement{connectedCallback(){let category='All';const input=this.querySelector('[data-search]') as HTMLInputElement;const cards=Array.from(this.querySelectorAll<HTMLElement>('[data-tool]'));const update=()=>{const q=input.value.trim().toLowerCase();let count=0;cards.forEach(c=>{c.hidden=!(c.dataset.text!.includes(q)&&(category==='All'||c.dataset.topic===category));if(!c.hidden)count++});this.querySelector('[data-count]')!.textContent=`${count} ${count===1?'result':'results'}`;(this.querySelector('[data-empty]') as HTMLElement).hidden=count!==0};input.oninput=update;this.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(b=>b.onclick=()=>{category=b.dataset.category!;this.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(x=>{x.classList.toggle('selected',x===b);x.setAttribute('aria-pressed',String(x===b))});update()});}}
customElements.define('tool-catalog',ToolCatalog);
</script>
