---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Layout from '../layouts/Layout.astro';
import {QUESTIONS} from '../lib/practice.mjs';
// Server-rendered notes on what a worksheet holds. They are hidden when the worksheet is printed.
const topicLabels=[['geometry','Geometry'],['trigonometry','Trigonometry'],['coordinates','Coordinates'],['polygons','Polygons'],['solids','Solids']];
const plain=q=>!/[<&]/.test(q.q+q.why+q.choices.join(''));
const samples=topicLabels.map(([value])=>QUESTIONS.filter(q=>q.topic===value&&plain(q))[2]).filter(Boolean);
---
<Layout title="Printable Geometry & Trigonometry Worksheet Generator" section="Practice" description="Build a printable geometry worksheet with 8, 12, or 20 questions and an optional answer key. Choose trigonometry, coordinates, polygons, solids, or a mixed set."><Breadcrumbs items={[['Tools','/tools/'],['Worksheet builder','/worksheets/']]}/><div class="intro"><div><div class="eyebrow">Take the learning with you</div><h1>Your next practice sheet.</h1><p>Choose a topic, generate a fresh set, and print with or without the answers.</p></div></div><worksheet-lab><div class="worksheet-controls"><label class="field">Topic<select data-topic><option value="mixed">Mixed topics</option><option value="geometry">Geometry</option><option value="trigonometry">Trigonometry</option><option value="coordinates">Coordinates</option><option value="polygons">Polygons</option><option value="solids">Solids</option></select></label><label class="field">Questions<select data-count><option>8</option><option>12</option><option>20</option></select></label><button class="secondary" data-generate>New question set</button><button class="primary" data-print>Print / save as PDF</button><label class="check-row"><input type="checkbox" data-key checked/> Include answer key</label></div><div class="worksheet-paper" data-paper></div></worksheet-lab><noscript>Enable JavaScript to generate a worksheet. All lessons are available in the formula reference.</noscript>
<section class="page-notes"><h2>What is on a worksheet</h2><p>Each worksheet is a fresh set of 8, 12 or 20 multiple-choice questions, chosen at random from a bank of {QUESTIONS.length}: {topicLabels.map(([value,label],i)=><>{i>0&&(i===topicLabels.length-1?' and ':', ')}{label.toLowerCase()} ({QUESTIONS.filter(q=>q.topic===value).length})</>)}. Pick one topic or a mixed set, then print it or save it as a PDF. The page prints with a line for the student’s name and the date. Tick “Include answer key” to add the answers and a worked explanation for every question on a separate part of the sheet. Press “New question set” for a different worksheet on the same topic, so neighbors do not get the same questions.</p>
<h2>Sample questions from the bank</h2><ol class="page-samples">{samples.map(q=><li><h3>{q.q}</h3><p><strong>Answer:</strong> {q.choices[q.answer]}. {q.why}</p></li>)}</ol>
<p>To answer on screen with instant feedback, use the <a href="/practice/">practice questions</a>. For one-page activities built around a single tool, see the <a href="/teachers/">teacher page</a>.</p></section></Layout>
<script>
import {makeRound} from '../lib/practice.mjs';
class WorksheetLab extends HTMLElement{connectedCallback(){const topic=this.querySelector('[data-topic]') as HTMLSelectElement,count=this.querySelector('[data-count]') as HTMLSelectElement,key=this.querySelector('[data-key]') as HTMLInputElement;const generate=()=>{const round=makeRound(topic.value,Number(count.value));this.querySelector('[data-paper]')!.innerHTML=`<h2>Geometry Lab · ${topic.options[topic.selectedIndex].text}</h2><p class="small-note">${round.length} questions · Choose one answer for each. Show your working in the space provided.</p><p class="worksheet-print-name">Name: ____________________ &nbsp; Date: ______________</p><ol class="worksheet-questions">${round.map(q=>`<li>${q.q}<div class="worksheet-options">${q.choices.map((c:any,i:number)=>`${'ABCD'[i]}. ${c.text}`).join('<br/>')}</div></li>`).join('')}</ol><section class="worksheet-answers" ${key.checked?'':'hidden'}><h2>Answer key & explanations</h2><ol>${round.map(q=>`<li><strong>${'ABCD'[q.choices.findIndex((c:any)=>c.correct)]}. ${q.choices.find((c:any)=>c.correct).text}</strong><br/>${q.why}</li>`).join('')}</ol></section>`};topic.onchange=generate;count.onchange=generate;key.onchange=()=>{(this.querySelector('.worksheet-answers') as HTMLElement).hidden=!key.checked};(this.querySelector('[data-generate]') as HTMLButtonElement).onclick=generate;(this.querySelector('[data-print]') as HTMLButtonElement).onclick=()=>window.print();generate();}}
customElements.define('worksheet-lab',WorksheetLab);
</script>
