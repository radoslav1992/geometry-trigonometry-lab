---
const {initial='rectangle',fixed=false}=Astro.props;
---
<shape-lab data-initial={initial}><div class="tabs" aria-label="Measurement type" hidden={fixed}><button class="tab" data-kind="area">Area & perimeter</button><button class="tab" data-kind="volume">Volume & surface area</button></div><div class="workbench"><div class="canvas-pane"><div class="canvas-top"><span class="canvas-title" data-heading>Rectangle</span><span class="canvas-hint">Change a dimension to explore</span></div><div class="graph"><svg viewBox="0 0 720 410" role="img" aria-label="Shape with labeled dimensions"><g data-drawing></g></svg></div><div class="graph-caption"><span data-formula>A = w × h</span><span data-diagram-note>Dimensions shown in the selected unit</span></div><div data-metrics class="result-grid" aria-live="polite"></div></div><div class="controls"><h3>Give your shape a size.</h3><label class="field" hidden={fixed}>Shape<select data-shape></select></label><div data-fields></div><label class="field">Length unit<select data-unit><option value="cm">centimeters (cm)</option><option value="m">meters (m)</option><option value="in">inches (in)</option><option value="ft">feet (ft)</option></select></label><p class="error" data-error role="alert"></p><div class="divider"></div><p class="small-note">Use the same unit for every dimension. Changing the unit relabels the measurements; it does not convert them.</p></div></div><div class="explanation"><h2>From dimensions to an answer</h2><div class="formula" data-worked></div><p data-explanation></p></div></shape-lab>
<noscript>Enable JavaScript to calculate a shape. Rectangle area = width × height; circle area = π × radius²; cylinder volume = π × radius² × height.</noscript>
<script>
import {SHAPES,shapeValues,fmt} from '../lib/math.mjs';
class ShapeLab extends HTMLElement {
 connectedCallback(){let shape=this.dataset.initial||'rectangle';let kind=SHAPES[shape].kind;const select=this.querySelector('[data-shape]') as HTMLSelectElement;
 const render=()=>{const values=Array.from(this.querySelectorAll<HTMLInputElement>('[data-dim]')).map(i=>i.value===''?NaN:Number(i.value));const unit=(this.querySelector('[data-unit]') as HTMLSelectElement).value;try{const result=shapeValues(shape,values);this.querySelector('[data-error]')!.textContent='';const [a,b,c]=values;const ink='stroke="#267e66" stroke-width="2.5" fill="#77b69725"';const line=(x1:number,y1:number,x2:number,y2:number)=>`<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#d47b47" stroke-width="2"/>`;const text=(x:number,y:number,s:string)=>`<text x="${x}" y="${y}" text-anchor="middle" class="diagram-label">${s}</text>`;let d='';
 if(shape==='rectangle'){const scale=Math.min(400/a,250/b);const w=a*scale,h=b*scale;d=`<rect x="${360-w/2}" y="${200-h/2}" width="${w}" height="${h}" ${ink}/>${text(360,230+h/2,`w = ${fmt(a)} ${unit}`)}${text(335-w/2,200,`h = ${fmt(b)}`)}`;}
 if(shape==='circle'){d=`<circle cx="360" cy="200" r="130" ${ink}/>${line(360,200,490,200)}<circle cx="360" cy="200" r="4" fill="#267e66"/>${text(425,183,`r = ${fmt(a)}`)}`;}
 if(shape==='triangle'){const scale=Math.min(400/a,240/b);const w=a*scale,h=b*scale;d=`<polygon points="${360-w/2},330 ${360+w/2},330 ${360-w/5},${330-h}" ${ink}/><path d="M ${360-w/5} ${330-h} V 330" stroke="#d47b47" stroke-width="2" stroke-dasharray="6 5"/>${text(360,360,`b = ${fmt(a)} ${unit}`)}${text(380-w/5,330-h/2,`h = ${fmt(b)}`)}`;}
 if(shape==='trapezoid'){const scale=Math.min(420/Math.max(a,b),230/c);d=`<polygon points="${360-a*scale/2},330 ${360+a*scale/2},330 ${360+b*scale/2},${330-c*scale} ${360-b*scale/2},${330-c*scale}" ${ink}/><line x1="360" x2="360" y1="330" y2="${330-c*scale}" stroke="#d47b47" stroke-dasharray="6 5"/>${text(360,360,`a = ${fmt(a)}`)}${text(360,310-c*scale,`b = ${fmt(b)}`)}${text(395,330-c*scale/2,`h = ${fmt(c)}`)}`;}
 if(shape==='sphere'){d=`<circle cx="360" cy="200" r="130" ${ink}/><ellipse cx="360" cy="200" rx="130" ry="38" fill="none" stroke="#267e66" stroke-dasharray="5 5"/>${line(360,200,490,200)}${text(420,182,`r = ${fmt(a)} ${unit}`)}`;}
 if(shape==='cylinder'||shape==='cone'){const scale=Math.min(120/a,240/b),r=a*scale,h=b*scale;const y=210-h/2,bot=210+h/2;d=shape==='cylinder'?`<path d="M ${360-r} ${y} L ${360-r} ${bot} A ${r} ${r*.3} 0 0 0 ${360+r} ${bot} L ${360+r} ${y}" ${ink}/><ellipse cx="360" cy="${y}" rx="${r}" ry="${r*.3}" ${ink}/>`:`<path d="M 360 ${y} L ${360-r} ${bot} A ${r} ${r*.3} 0 0 0 ${360+r} ${bot} Z" ${ink}/><ellipse cx="360" cy="${bot}" rx="${r}" ry="${r*.3}" fill="none" stroke="#267e66" stroke-dasharray="5 5"/>`;d+=`${line(360,bot,360+r,bot)}${text(360+r/2,bot+40,`r = ${fmt(a)}`)}${text(390+r,210,`h = ${fmt(b)}`)}`;}
 if(shape==='cuboid'){const s=Math.min(300/a,200/b,110/c),w=a*s,h=b*s,dx=c*s*.7,dy=-c*s*.45,x=340-w/2,y=220-h/2;d=`<path d="M ${x} ${y} h ${w} v ${h} h ${-w} Z M ${x} ${y} l ${dx} ${dy} h ${w} v ${h} l ${-dx} ${-dy} M ${x+w} ${y} l ${dx} ${dy}" ${ink}/>${text(x+w/2,y+h+30,`w = ${fmt(a)}`)}${text(x-35,y+h/2,`h = ${fmt(b)}`)}${text(x+w+dx/2+25,y+h+dy/2+15,`d = ${fmt(c)}`)}`;}
 this.querySelector('[data-drawing]')!.innerHTML=d;this.querySelector('[data-metrics]')!.innerHTML=Object.entries(result).map(([label,val])=>`<div class="result-tile"><span>${label}</span><strong>${fmt(val as number)} ${unit}${label==='Volume'?'³':label.toLowerCase().includes('area')?'²':''}</strong></div>`).join('');this.querySelector('[data-heading]')!.textContent=SHAPES[shape].title;this.querySelector('[data-formula]')!.textContent=SHAPES[shape].formula;this.querySelector('[data-diagram-note]')!.textContent=kind==='volume'?'Perspective illustration · hidden surfaces included':'Proportions reflect your dimensions';
 const substitutions:Record<string,string>={rectangle:`${fmt(a)} × ${fmt(b||0)}`,circle:`π × ${fmt(a)}²`,triangle:`½ × ${fmt(a)} × ${fmt(b||0)}`,trapezoid:`½ × (${fmt(a)} + ${fmt(b||0)}) × ${fmt(c||0)}`,sphere:`⁴⁄₃ × π × ${fmt(a)}³`,cylinder:`π × ${fmt(a)}² × ${fmt(b||0)}`,cone:`⅓ × π × ${fmt(a)}² × ${fmt(b||0)}`,cuboid:`${fmt(a)} × ${fmt(b||0)} × ${fmt(c||0)}`};const first=Object.values(result)[0] as number;
 this.querySelector('[data-worked]')!.textContent=`${kind==='area'?'A':'V'} = ${substitutions[shape]} = ${fmt(first)} ${unit}${kind==='area'?'²':'³'}`;this.querySelector('[data-explanation]')!.textContent=kind==='area'?'Area measures the flat space inside the boundary and is expressed in square units. Perimeter or circumference measures the distance around the boundary.':'Volume measures the space inside the solid, in cubic units. Surface area includes the full outer surface, including the base and top where applicable. Calculations use full precision; displayed results are rounded.';
 }catch(e){this.querySelector('[data-error]')!.textContent=(e as Error).message;this.querySelector('[data-metrics]')!.innerHTML='';this.querySelector('[data-drawing]')!.innerHTML='<text x="360" y="205" text-anchor="middle">Enter valid dimensions to see your shape.</text>';this.querySelector('[data-worked]')!.textContent='Enter every dimension to calculate.';this.querySelector('[data-explanation]')!.textContent=''}};
 const fields=()=>{this.querySelector('[data-fields]')!.innerHTML=SHAPES[shape].fields.map((label:string,i:number)=>`<label class="field">${label}<input data-dim type="number" min="0.000001" step="any" value="${SHAPES[shape].defaults[i]}"/></label>`).join('');this.querySelectorAll<HTMLInputElement>('[data-dim]').forEach(i=>i.oninput=render);render()};
 const setup=()=>{select.innerHTML=Object.entries(SHAPES).filter(([,v])=>v.kind===kind).map(([key,v])=>`<option value="${key}" ${key===shape?'selected':''}>${v.title}</option>`).join('');this.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach(b=>{b.classList.toggle('active',b.dataset.kind===kind);b.setAttribute('aria-pressed',String(b.dataset.kind===kind))});fields()};
 select.onchange=()=>{shape=select.value;fields()};this.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach(b=>b.onclick=()=>{kind=b.dataset.kind!;shape=kind==='area'?'rectangle':'sphere';setup()});(this.querySelector('[data-unit]') as HTMLSelectElement).onchange=render;setup();
 }
}
customElements.define('shape-lab',ShapeLab);
</script>
