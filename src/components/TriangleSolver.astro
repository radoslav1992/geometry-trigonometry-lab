<triangle-lab>
<div class="tabs" aria-label="Triangle input method">{[['sss','Three sides (SSS)'],['sas','Two sides + angle (SAS)'],['asa','Two angles + side (AAS)'],['ssa','Two sides + opposite angle (SSA)']].map(([id,label])=><button data-mode={id} class:list={['tab',{active:id==='sss'}]} aria-pressed={id==='sss'}>{label}</button>)}</div>
<div class="workbench"><div class="canvas-pane"><div class="canvas-top"><span class="canvas-title">Your triangle <span class="badge" data-classification>RIGHT TRIANGLE</span></span><span class="canvas-hint">Drawn to scale</span></div><div class="graph"><svg viewBox="0 0 720 410" role="img" aria-label="Triangle with labeled sides and angles"><g data-drawing></g></svg></div><div class="graph-caption"><span>Lowercase letters = sides · uppercase letters = opposite angles</span></div><div data-metrics class="result-grid" aria-live="polite"></div></div><div class="controls"><h3>What do you know?</h3><div data-fields></div><label class="field">Length unit<select data-unit><option value="units">units</option><option value="cm">cm</option><option value="m">m</option><option value="in">in</option></select></label><button class="primary full-width" data-solve>Solve triangle</button><p class="error" data-error role="alert"></p><div data-solutions class="pills" style="margin-top:15px"></div><div class="divider"></div><p class="small-note" data-mode-help>Each side must be shorter than the other two combined.</p><button class="secondary full-width" data-reset style="margin-top:20px">Reset example</button></div></div>
<div class="explanation"><h2>Follow the calculation</h2><div data-steps></div></div>
</triangle-lab><noscript>Enable JavaScript to solve a triangle. For sides 3, 4, and 5, the area is 6 square units and the angles are approximately 36.87°, 53.13°, and 90°.</noscript>
<script>
import {solveTriangle,fmt,rad} from '../lib/math.mjs';
class TriangleLab extends HTMLElement {
 connectedCallback(){let mode='sss',results:any[]=[],chosen=0;const config:Record<string,any>={sss:{labels:['Side a','Side b','Side c'],values:[3,4,5],help:'Each side must be shorter than the other two combined.'},sas:{labels:['Side a','Side b','Included angle C (°)'],values:[6,8,60],help:'The known angle C sits between the two known sides a and b.'},asa:{labels:['Angle A (°)','Angle B (°)','Side c'],values:[45,60,8],help:'Side c is opposite the remaining angle C. The known angles must total less than 180°.'},ssa:{labels:['Side a','Side b','Angle A (°)'],values:[7,10,30],help:'This ambiguous case may give no triangle, one triangle, or two triangles. We check both possibilities.'}};
 const draw=()=>{const t=results[chosen];if(!t)return;const unit=(this.querySelector('[data-unit]') as HTMLSelectElement).value;const ux=(t.b*t.b+t.c*t.c-t.a*t.a)/(2*t.c);const uy=Math.sqrt(Math.max(0,t.b*t.b-ux*ux));const minX=Math.min(0,ux),maxX=Math.max(t.c,ux);const scale=Math.min(470/(maxX-minX),240/uy);const off=360-(maxX+minX)*scale/2;const A={x:off,y:330},B={x:off+t.c*scale,y:330},C={x:off+ux*scale,y:330-uy*scale};
 this.querySelector('[data-drawing]')!.innerHTML=`<polygon points="${A.x},${A.y} ${B.x},${B.y} ${C.x},${C.y}" fill="#65b89424" stroke="#267e66" stroke-width="2.5"/>${[A,B,C].map(p=>`<circle cx="${p.x}" cy="${p.y}" r="5" fill="#267e66" stroke="#fff" stroke-width="2"/>`).join('')}<text x="${A.x-15}" y="${A.y+27}" class="diagram-label">A</text><text x="${B.x+8}" y="${B.y+27}" class="diagram-label">B</text><text x="${C.x}" y="${C.y-17}" text-anchor="middle" class="diagram-label">C</text><text x="${(A.x+B.x)/2}" y="${A.y+35}" text-anchor="middle">c = ${fmt(t.c)}</text><text x="${(A.x+C.x)/2-15}" y="${(A.y+C.y)/2}" text-anchor="end">b = ${fmt(t.b)}</text><text x="${(B.x+C.x)/2+17}" y="${(B.y+C.y)/2}" text-anchor="start">a = ${fmt(t.a)}</text><rect x="24" y="24" width="210" height="45" rx="8" fill="white" stroke="#dce5e1"/><text x="38" y="52">A + B + C = 180°</text>`;
 const right=[t.A,t.B,t.C].some(a=>Math.abs(a-90)<1e-7);this.querySelector('[data-classification]')!.textContent=right?'RIGHT TRIANGLE':Math.max(t.A,t.B,t.C)>90?'OBTUSE TRIANGLE':'ACUTE TRIANGLE';
 this.querySelector('[data-metrics]')!.innerHTML=[['Angle A',fmt(t.A)+'°'],['Angle B',fmt(t.B)+'°'],['Angle C',fmt(t.C)+'°'],['Area',fmt(t.area)+' '+unit+'²'],['Perimeter',fmt(t.perimeter)+' '+unit],['Height to c',fmt(t.height)+' '+unit]].map(([label,val])=>`<div class="result-tile"><span>${label}</span><strong>${val}</strong></div>`).join('');
 const intro=mode==='sas'?`Use the cosine rule for the missing side: c² = a² + b² − 2ab cos C.`:mode==='asa'?`Find C = 180° − A − B, then use a/sin A = b/sin B = c/sin C.`:mode==='ssa'?`Use sin B = b sin A / a. Test both B and 180° − B; retain only triangles with A + B < 180°. ${results.length} valid solution${results.length===1?'':'s'} found.`:`Use the cosine rule: A = arccos((b² + c² − a²) / (2bc)).`;
 this.querySelector('[data-steps]')!.innerHTML=`<ol><li>${intro}</li><li>The sides are a = ${fmt(t.a)}, b = ${fmt(t.b)}, c = ${fmt(t.c)} ${unit}.</li><li>The angles are A = ${fmt(t.A)}°, B = ${fmt(t.B)}°, C = ${fmt(t.C)}°. Their sum is 180° before rounding.</li><li>The semiperimeter is s = (a + b + c) / 2 = ${fmt(t.perimeter/2)} ${unit}.</li><li>Heron’s formula gives area = √[s(s − a)(s − b)(s − c)] = ${fmt(t.area)} ${unit}².</li></ol>`;
 this.querySelector('[data-solutions]')!.innerHTML=results.length>1?results.map((_,i)=>`<button class="pill ${i===chosen?'selected':''}" data-solution="${i}" aria-pressed="${i===chosen}">Solution ${i+1}</button>`).join(''):'';this.querySelectorAll<HTMLButtonElement>('[data-solution]').forEach(b=>b.onclick=()=>{chosen=Number(b.dataset.solution);draw()});};
 const solve=()=>{try{results=solveTriangle(mode,Array.from(this.querySelectorAll<HTMLInputElement>('[data-value]')).map(i=>i.value===''?NaN:Number(i.value)));chosen=0;this.querySelector('[data-error]')!.textContent='';draw();}catch(e){this.querySelector('[data-error]')!.textContent=(e as Error).message;this.querySelector('[data-drawing]')!.innerHTML='<text x="360" y="205" text-anchor="middle">Check the measurements to draw your triangle.</text>';this.querySelector('[data-metrics]')!.innerHTML='';this.querySelector('[data-steps]')!.textContent='Correct the measurements above to see the calculation.';this.querySelector('[data-solutions]')!.innerHTML='';this.querySelector('[data-classification]')!.textContent='CHECK INPUTS';results=[]}};
 const setup=()=>{this.querySelector('[data-fields]')!.innerHTML=config[mode].labels.map((label:string,i:number)=>`<label class="field">${label}<input data-value type="number" min="0.000001" step="any" value="${config[mode].values[i]}"/></label>`).join('');this.querySelector('[data-mode-help]')!.textContent=config[mode].help;this.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(b=>{b.classList.toggle('active',b.dataset.mode===mode);b.setAttribute('aria-pressed',String(b.dataset.mode===mode))});this.querySelectorAll<HTMLInputElement>('[data-value]').forEach(i=>{i.onchange=solve;i.onkeydown=e=>{if(e.key==='Enter')solve()}});solve()};
 this.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(b=>b.onclick=()=>{mode=b.dataset.mode!;setup()});(this.querySelector('[data-solve]') as HTMLButtonElement).onclick=solve;(this.querySelector('[data-reset]') as HTMLButtonElement).onclick=setup;(this.querySelector('[data-unit]') as HTMLSelectElement).onchange=draw;setup();
 }
}
customElements.define('triangle-lab',TriangleLab);
</script>
