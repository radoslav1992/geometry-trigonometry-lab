<composite-lab><div class="explanation composite-panel"><h2 id="composite-heading">Composite shape area calculator</h2><p>Break an irregular figure into rectangles, triangles, and circle parts. Add each piece, and subtract any hole or cut-out corner. The default L-shape is a 10 × 6 rectangle with a 4 × 3 corner removed.</p><div class="composite-rows" data-rows aria-live="polite"></div><div class="composite-total"><button class="secondary" data-add>+ Add a part</button><div><span class="small-note">Total area</span><br/><strong data-total>48 units²</strong></div></div><p class="error" data-error role="alert"></p><div class="formula" data-working>60 − 12 = 48 units²</div></div></composite-lab>
<noscript>Enable JavaScript to use the composite calculator. Example: a 10 × 6 rectangle with a 4 × 3 corner removed has area 60 − 12 = 48 square units.</noscript>
<script>
import {COMPOSITE_PARTS,compositeArea,fmt} from '../lib/math.mjs';
class CompositeLab extends HTMLElement{
 connectedCallback(){let parts=[{op:'add',shape:'rectangle',values:[10,6]},{op:'subtract',shape:'rectangle',values:[4,3]}];const rows=this.querySelector('[data-rows]')!;
 const calc=()=>{try{const out=compositeArea(parts);this.querySelector('[data-total]')!.textContent=`${fmt(out.total)} units²`;this.querySelector('[data-working]')!.textContent=out.rows.map((r,i)=>`${i?r.op==='add'?' + ':' − ':''}${fmt(r.area)}`).join('')+` = ${fmt(out.total)} units²`;this.querySelector('[data-error]')!.textContent=''}catch(e){this.querySelector('[data-error]')!.textContent=(e as Error).message;this.querySelector('[data-total]')!.textContent='—';this.querySelector('[data-working]')!.textContent='Correct the parts to see the working.'}};
 const draw=()=>{rows.innerHTML=parts.map((p,i)=>{const part=(COMPOSITE_PARTS as any)[p.shape];return `<div class="composite-row" data-index="${i}"><label class="field">Part ${i+1}<select data-op><option value="add" ${p.op==='add'?'selected':''}>Add</option><option value="subtract" ${p.op==='subtract'?'selected':''}>Subtract</option></select></label><label class="field">Shape<select data-part>${Object.entries(COMPOSITE_PARTS).map(([key,v]:any)=>`<option value="${key}" ${key===p.shape?'selected':''}>${v.title}</option>`).join('')}</select></label>${part.fields.map((label:string,j:number)=>`<label class="field">${label}<input type="number" min="0.000001" step="any" data-value="${j}" value="${p.values[j]}"/></label>`).join('')}${'<span></span>'.repeat(3-part.fields.length)}<button class="remove" data-remove aria-label="Remove part ${i+1}" ${parts.length===1?'disabled':''}>×</button></div>`}).join('');
 rows.querySelectorAll<HTMLElement>('.composite-row').forEach(row=>{const p=parts[Number(row.dataset.index)];(row.querySelector('[data-op]') as HTMLSelectElement).onchange=e=>{p.op=(e.target as HTMLSelectElement).value;calc()};(row.querySelector('[data-part]') as HTMLSelectElement).onchange=e=>{p.shape=(e.target as HTMLSelectElement).value;p.values=[...(COMPOSITE_PARTS as any)[p.shape].defaults];draw()};row.querySelectorAll<HTMLInputElement>('[data-value]').forEach(input=>input.oninput=()=>{p.values[Number(input.dataset.value)]=input.value===''?NaN:Number(input.value);calc()});(row.querySelector('[data-remove]') as HTMLButtonElement).onclick=()=>{parts.splice(Number(row.dataset.index),1);draw()}});calc()};
 (this.querySelector('[data-add]') as HTMLButtonElement).onclick=()=>{parts.push({op:'add',shape:'triangle',values:[...COMPOSITE_PARTS.triangle.defaults]});draw()};draw();
 }
}
customElements.define('composite-lab',CompositeLab);
</script>
