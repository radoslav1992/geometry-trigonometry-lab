---
// Visible trail plus matching BreadcrumbList structured data. Items are [name, path] pairs after Home.
interface Props { items: [string, string][] }
const { items } = Astro.props;
const trail = [['Home', '/'], ...items];
const schema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: trail.map(([name, path], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(path, Astro.site).href })) };
---
<nav class="breadcrumb" aria-label="Breadcrumb">{trail.map(([name, path], i) => <>{i > 0 && ' / '}{i < trail.length - 1 ? <a href={path}>{name}</a> : <span aria-current="page">{name}</span>}</>)}</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
