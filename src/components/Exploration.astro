---
const {tool}=Astro.props;
---
<exploration-lab data-slug={tool.slug}>
{tool.modes&&<div class="tabs" aria-label="Exploration mode">{tool.modes.map(([value,label],i)=><button class:list={['tab',{active:i===0}]} data-mode={value} aria-pressed={i===0}>{label}</button>)}</div>}
<div class="workbench"><div class="canvas-pane"><div class="canvas-top"><span class="canvas-title">{tool.title}</span><span class="badge">LIVE EXPLORATION</span></div><div class="graph large-graph"><svg viewBox="0 0 720 520" role="img" aria-label={tool.title+' diagram'}><g data-drawing></g></svg></div><div class="graph-caption"><span>{['coordinate-geometry','triangle-playground'].includes(tool.slug)?'Drag a labeled point · enter coordinates for precision':tool.category==='Coordinates'?'Green: original · orange: transformed':'Change a value to see the connection'}</span></div><div class="result-grid" data-results aria-live="polite"></div></div><div class="controls"><h3>Your measurements</h3>{tool.fields.map(f=><label class="field" data-field-wrap={f.key}>{f.label}<input type="number" data-field={f.key} value={f.value} min={f.min} max={f.max} step={f.step}/></label>)}
{tool.slug==='polygon-explorer'&&<div class="pills">{[3,4,5,6,8,12].map(n=><button class="pill" data-preset={n}>{n} sides</button>)}</div>}
{tool.slug==='circle-sectors'&&<div class="pills">{[30,60,90,180,270].map(n=><button class="pill" data-preset={n}>{n}°</button>)}</div>}
{tool.slug==='angle-converter'&&<div class="pills">{[30,45,90,180,360].map(n=><button class="pill" data-preset={n}>{n}°</button>)}</div>}
<p class="error" data-error role="alert"></p><button class="secondary full-width" data-reset>Reset example</button><p class="small-note">{tool.note}</p></div></div>
{tool.slug==='triangle-playground'&&<div class="explanation challenge-panel"><h2>Discovery challenges</h2><p>Choose a goal, then move the vertices to find a solution. Classification uses a small numerical tolerance.</p><div class="pills"><button class="pill selected" data-challenge="right" aria-pressed="true">Make a right triangle</button><button class="pill" data-challenge="isosceles" aria-pressed="false">Make an isosceles triangle</button><button class="pill" data-challenge="area" aria-pressed="false">Make an area of 24</button></div><p data-challenge-result aria-live="polite"></p></div>}
<div class="explanation"><h2>Why it works</h2><div class="formula">{tool.formula}</div><ol data-steps></ol></div>
</exploration-lab><noscript>Enable JavaScript for the interactive diagram and calculations. Formula: {tool.formula}. The linked lesson explains the method with a worked example.</noscript>
<script>
import {explorations,explore} from '../lib/explorations.mjs';import {explorationDiagram} from '../lib/diagrams.mjs';import {rad} from '../lib/math.mjs';
class ExplorationLab extends HTMLElement{
 connectedCallback(){const tool=explorations.find(t=>t.slug===this.dataset.slug)!;let mode=tool.modes?.[0][0]||'',challenge='right';let model:any;const inputs=Array.from(this.querySelectorAll<HTMLInputElement>('[data-field]'));const svg=this.querySelector('svg')!;
 const challengeResult=()=>{const node=this.querySelector('[data-challenge-result]');if(!node||!model)return;const done=challenge==='right'?model.right:challenge==='isosceles'?['Isosceles','Equilateral'].includes(model.type):Math.abs(model.area-24)<0.05;node.textContent=done?'Challenge complete! Change another vertex and see what happens.':'Keep exploring. There are many valid solutions.';node.classList.toggle('challenge-done',done)};
 const update=()=>{const values=Object.fromEntries(inputs.map(i=>[i.dataset.field,i.value===''?NaN:Number(i.value)]));try{const out=explore(tool.slug,values,mode);model=out.model;this.querySelector('[data-drawing]')!.innerHTML=explorationDiagram(tool.slug,model);this.querySelector('[data-results]')!.innerHTML=out.metrics.map(m=>`<div class="result-tile"><span>${m.label}</span><strong>${m.value}</strong></div>`).join('');this.querySelector('[data-steps]')!.replaceChildren(...out.steps.map(s=>{const li=document.createElement('li');li.textContent=s;return li}));this.querySelector('[data-error]')!.textContent='';challengeResult()}catch(e){this.querySelector('[data-error]')!.textContent=(e as Error).message+' The diagram retains the last valid measurements.';this.querySelector('[data-results]')!.innerHTML='';this.querySelector('[data-steps]')!.textContent='Correct the measurements to see the calculation.';const c=this.querySelector('[data-challenge-result]');if(c)c.textContent='Enter valid points to continue the challenge.';}};
 const modeUI=()=>{this.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(b=>{b.classList.toggle('active',b.dataset.mode===mode);b.setAttribute('aria-pressed',String(b.dataset.mode===mode))});if(tool.slug==='transformations'){const keys=mode==='translate'?['dx','dy']:mode==='rotate'?['angle']:mode==='scale'?['scale']:[];this.querySelectorAll<HTMLElement>('[data-field-wrap]').forEach(w=>w.hidden=!keys.includes(w.dataset.fieldWrap!));}update()};
 inputs.forEach(i=>i.addEventListener('input',update));this.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(b=>b.onclick=()=>{mode=b.dataset.mode!;modeUI()});(this.querySelector('[data-reset]') as HTMLButtonElement).onclick=()=>{inputs.forEach(i=>i.value=String(tool.fields.find(f=>f.key===i.dataset.field)!.value));mode=tool.modes?.[0][0]||'';modeUI()};
 this.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach(b=>b.onclick=()=>{const n=Number(b.dataset.preset);const key=tool.slug==='polygon-explorer'?'n':tool.slug==='circle-sectors'?'theta':'angle';const i=inputs.find(i=>i.dataset.field===key)!;i.value=String(key==='angle'?(mode==='radians'?rad(n):mode==='turns'?n/360:n):n);update()});
 this.querySelectorAll<HTMLButtonElement>('[data-challenge]').forEach(b=>b.onclick=()=>{challenge=b.dataset.challenge!;this.querySelectorAll<HTMLButtonElement>('[data-challenge]').forEach(x=>{x.classList.toggle('selected',x===b);x.setAttribute('aria-pressed',String(x===b))});challengeResult()});
 let dragging:number|null=null;const move=(e:PointerEvent)=>{if(dragging===null)return;const p=svg.createSVGPoint();p.x=e.clientX;p.y=e.clientY;const matrix=svg.getScreenCTM();if(!matrix)return;const loc=p.matrixTransform(matrix.inverse());const keys=tool.slug==='coordinate-geometry'?[['x1','y1'],['x2','y2']]:[['ax','ay'],['bx','by'],['cx','cy']];keys[dragging].forEach((key,index)=>{const i=inputs.find(i=>i.dataset.field===key)!;const f=tool.fields.find(f=>f.key===key)!;const raw=index===0?(loc.x-360)/22:(260-loc.y)/22;i.value=String(Math.round(Math.min(f.max,Math.max(f.min,raw))*10)/10)});update()};
 svg.addEventListener('pointerdown',e=>{const target=(e.target as Element).closest('[data-point]') as SVGElement|null;if(!target)return;dragging=Number(target.dataset.point);svg.setPointerCapture(e.pointerId);move(e)});svg.addEventListener('pointermove',move);svg.addEventListener('pointerup',()=>dragging=null);svg.addEventListener('pointercancel',()=>dragging=null);modeUI();
 }
}
customElements.define('exploration-lab',ExplorationLab);
</script>
