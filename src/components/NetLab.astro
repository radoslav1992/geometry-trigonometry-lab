---
// The printable net builder. On the hub it offers every solid; a net page passes `initial` and
// `fixed` to show one solid, and `details` to add the pieces and surface-area working below it.
// The default net is rendered here on the server, so the page prints before JavaScript runs.
import {NETS,netSvg,netDetails,netGeometry} from '../lib/nets.mjs';
import {fmt} from '../lib/math.mjs';
const {initial='cube',fixed=false,details=false}=Astro.props;
const net=NETS[initial],name=net.title.toLowerCase();
const info=netDetails(initial,net.values),box=netGeometry(initial,net.values).box;
---
<net-lab id="net-lab" data-initial={initial}><div class="workbench"><div class="canvas-pane"><div class="canvas-top"><span class="canvas-title">Your printable {fixed?`${name} `:''}net</span><span class="badge">A4 · PORTRAIT</span></div><div class="graph net-paper" data-preview set:html={netSvg(initial,net.values)}></div><div class="graph-caption"><span>Solid lines: cut · dashed lines: fold</span><span>Dimensions in millimeters</span></div></div><div class="controls"><h3>{fixed?`Set the size of your ${name}.`:'Build something tangible.'}</h3><label class="field" hidden={fixed}>Solid<select data-shape>{Object.entries(NETS).map(([shape,item])=><option value={shape} selected={shape===initial}>{item.title}</option>)}</select></label><div data-fields>{net.labels.map((label,i)=><label class="field">{label}<input data-dimension type="number" min="5" max="100" step="1" value={net.values[i]}/></label>)}</div><label class="check-row"><input data-tabs type="checkbox" checked/> Add glue tabs</label><label class="check-row"><input data-labels type="checkbox" checked/> Label the faces</label><p class="error" data-error role="alert"></p><button class="primary full-width" data-download>Download SVG</button><button class="secondary full-width" data-print style="margin-top:10px">Print / save as PDF</button><p class="small-note">Print on A4 at 100% scale. Turn off browser headers and footers. The 20 mm reference line lets you check the printed size.</p></div></div>
{details&&<div class="shape-intro-grid shape-reference-grid no-print"><section class="shape-fact-box"><h2>Dimensions of this {name} net</h2><table class="fact-table"><tbody><tr><th scope="row">Pieces</th><td><ul class="net-list" data-pieces>{info.pieces.map(piece=><li>{piece}</li>)}</ul></td></tr><tr><th scope="row">Size on the page</th><td data-size>{fmt(box[2]-box[0],1)} × {fmt(box[3]-box[1],1)} mm without tabs</td></tr><tr><th scope="row">Paper</th><td>One A4 sheet, printed at 100%</td></tr></tbody></table><p>These numbers follow the sizes you enter above. Every dimension can be 5 to 100 mm, as long as the whole net fits on the page.</p></section><section class="shape-fact-box"><h2>Surface area from the net</h2><p>The surface area of the {name} is the total area of the pieces of its net. Glue tabs are not part of the surface.</p><div class="formula" data-formula>{info.formula}</div><ol class="net-list" data-steps>{info.steps.map(step=><li>{step}</li>)}</ol></section></div>}
</net-lab>
<script>
import {NETS,netSvg,netDetails,netGeometry} from '../lib/nets.mjs';
import {fmt} from '../lib/math.mjs';
class NetLab extends HTMLElement {
 connectedCallback(){let shape=this.dataset.initial||'cube',svgText='';
 const fill=(selector:string,items:string[])=>this.querySelector(selector)?.replaceChildren(...items.map(text=>{const li=document.createElement('li');li.textContent=text;return li}));
 const render=()=>{const vals=Array.from(this.querySelectorAll<HTMLInputElement>('[data-dimension]')).map(i=>i.value===''?NaN:Number(i.value));const tabs=(this.querySelector('[data-tabs]') as HTMLInputElement).checked;const labels=(this.querySelector('[data-labels]') as HTMLInputElement).checked;const buttons=this.querySelectorAll<HTMLButtonElement>('[data-download],[data-print]');try{svgText=netSvg(shape,vals,{tabs,labels});
 this.querySelector('[data-preview]')!.innerHTML=svgText;this.querySelector('[data-error]')!.textContent='';buttons.forEach(b=>b.disabled=false);
 if(this.querySelector('[data-steps]')){const info=netDetails(shape,vals),box=netGeometry(shape,vals).box;fill('[data-pieces]',info.pieces);fill('[data-steps]',info.steps);this.querySelector('[data-formula]')!.textContent=info.formula;this.querySelector('[data-size]')!.textContent=`${fmt(box[2]-box[0],1)} × ${fmt(box[3]-box[1],1)} mm without tabs`;}
 }catch(e){this.querySelector('[data-error]')!.textContent=(e as Error).message;this.querySelector('[data-preview]')!.innerHTML='<p style="padding:40px">Adjust the dimensions to generate a printable net.</p>';svgText='';buttons.forEach(b=>b.disabled=true)}};
 const select=this.querySelector('[data-shape]') as HTMLSelectElement;
 const setup=()=>{this.querySelector('[data-fields]')!.innerHTML=NETS[shape].labels.map((s:string,i:number)=>`<label class="field">${s}<input data-dimension type="number" min="5" max="100" step="1" value="${NETS[shape].values[i]}"/></label>`).join('');this.querySelectorAll<HTMLInputElement>('[data-dimension]').forEach(i=>i.oninput=render);render()};select.onchange=()=>{shape=select.value;setup()};this.querySelectorAll<HTMLInputElement>('[data-tabs],[data-labels]').forEach(i=>i.onchange=render);(this.querySelector('[data-download]') as HTMLButtonElement).onclick=()=>{if(!svgText)return;const u=URL.createObjectURL(new Blob([svgText],{type:'image/svg+xml'}));const a=document.createElement('a');a.href=u;a.download=`geometry-lab-${NETS[shape].file}.svg`;a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)};(this.querySelector('[data-print]') as HTMLButtonElement).onclick=()=>{if(svgText)window.print()};
 document.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach(a=>a.addEventListener('click',()=>{shape=a.dataset.pick!;select.value=shape;setup()}));setup();
 }
}
customElements.define('net-lab',NetLab);
</script>
