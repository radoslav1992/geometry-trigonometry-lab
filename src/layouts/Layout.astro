---
import '../styles/global.css';
import '../styles/studio.css';
const { title = 'Geometry & Trigonometry Lab', description = 'Free visual geometry tools: solve triangles, explore the unit circle, calculate area and volume, and practice with instant explanations.', section='Explore' } = Astro.props;
const activeSection = ['Triangle solver','Unit circle','Area & volume'].includes(section)?'Tools':section;
const url = new URL(Astro.url.pathname, Astro.site);
const nav=[['Explore','/'],['Tools','/tools/'],['Shapes','/shapes/'],['Practice','/practice/'],['Printables','/printable-nets/'],['Learn','/learn/']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title === 'Geometry & Trigonometry Lab' ? title : `${title} | Geometry Lab`}</title>
  <meta name="description" content={description}/><link rel="canonical" href={url}/>
  <meta name="theme-color" content="#fffaf1"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={url}/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebApplication',name:title,url:url.href,description,applicationCategory:'EducationalApplication',operatingSystem:'Any',isAccessibleForFree:true,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}})} />
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9CCD0H600F"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-9CCD0H600F');
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header"><a href="/" class="brand" aria-label="Geometry Lab home"><img src="/favicon.svg" width="37" height="37" alt=""/><span>geometry<span class="brand-light">lab</span><small>A PLACE FOR THINGS TO CLICK.</small></span></a><nav aria-label="Main navigation">{nav.map(([label,href])=><a href={href} class:list={{active:activeSection===label}} aria-current={activeSection===label?'page':undefined}>{label}</a>)}</nav><a href="/worksheets/" class="header-learn">Worksheets <span aria-hidden="true">↗</span></a></header>
  <main id="main"><slot/></main>
  <footer class="site-footer"><a href="/" class="footer-brand">geometry<span class="brand-light">lab</span></a><p>A little curiosity. A clearer picture.</p><div><a href="/learn/">Formula reference</a><a href="/about/">About this lab</a><a href="mailto:info@geometrylab.net">info@geometrylab.net</a></div><span>Free to explore. No account needed.</span></footer>
</body>
</html>
